# ~/.hermes/.env — environment variables for Hermes Agent
#
# Copy this file to ~/.hermes/.env and fill in your real values.
# The real .env is NEVER committed (it's in .gitignore).
#
# Restore on a new machine:
#   cp .env.example ~/.hermes/.env
#   chmod 600 ~/.hermes/.env
#   # then edit ~/.hermes/.env and fill each variable

OPENROUTER_API_KEY=
TERMINAL_MODAL_IMAGE=
TERMINAL_TIMEOUT=
TERMINAL_LIFETIME_SECONDS=
BROWSERBASE_PROXIES=
BROWSERBASE_ADVANCED_STEALTH=
BROWSER_SESSION_TIMEOUT=
BROWSER_INACTIVITY_TIMEOUT=
WEB_TOOLS_DEBUG=
VISION_TOOLS_DEBUG=
MOA_TOOLS_DEBUG=
IMAGE_TOOLS_DEBUG=
MINIMAX_API_KEY=
HERMES_MAX_ITERATIONS=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
TELEGRAM_HOME_CHANNEL=
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USERS=
DISCORD_HOME_CHANNEL=
EXA_API_KEY=
PERSONAL_AI_BASE_URL=
PERSONAL_AI_API_KEY=
PERSONAL_AI_REMOTE_URL=
PERSONAL_AI_USER_ID=
