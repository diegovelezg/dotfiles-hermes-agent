# Brave Search Patch para hermes-agent/tools/web_tools.py
# Aplica con: patch -p1 < patches/brave-search.patch

--- a/tools/web_tools.py
+++ b/tools/web_tools.py
@@ -70,24 +70,30 @@ def _get_backend() -> str:
-    """Determine which web backend to use..."""
-    # ... old fallback chain: firecrawl > parallel > tavily > exa > brave
-    # Returns first available backend based on API keys
+    """Determine which web backend to use.
+    Default: exa (unless explicitly configured)
+    """
+    configured = (_load_web_config().get("backend") or "").lower().strip()
+    if configured in ("parallel", "firecrawl", "tavily", "exa", "brave"):
+        return configured
+    return "exa"

+def _get_fallback_backend(failed_backend: str) -> str:
+    """Return fallback when primary backend fails.
+    exa → brave
+    """
+    if failed_backend == "exa":
+        return "brave"
+    return "firecrawl"

@@ -175,22 +181,14 @@ def _brave_search_request(endpoint: str, params: dict) -> dict:
-    """Send a GET request to the Brave Search API..."""
-    api_key = os.getenv("BRAVE_API_KEY")
-    headers = {
-        "X-Skip-Authorization-Header": "true",
-        "Accept": "application/json",
-    }
-    url = f"{_BRAVE_BASE_URL}/reso/v1/{endpoint}"
-    req = urllib.request.Request(url, headers=headers, method="GET")
-    req.add_header("Authorization", f"Bearer {api_key}")
-    for k, v in params.items():
-        if v is not None:
-            req.add_header(k, str(v) if v is not None else "")
-    with urllib.request.urlopen(req, timeout=30) as resp:
-        return json.loads(resp.read())
+    """Send a GET request using X-Subscription-Token auth and httpx."""
+    api_key = os.getenv("BRAVE_API_KEY")
+    headers = {
+        "Accept": "application/json",
+        "X-Subscription-Token": api_key,
+    }
+    url = f"{_BRAVE_BASE_URL}/res/v1/{endpoint}"
+    with httpx.Client(timeout=30.0) as client:
+        response = client.get(url, headers=headers, params=params)
+        return response.json()

@@ -213,7 +211,7 @@ def _brave_search(query: str, limit: int = 10) -> dict:
-    response = _brave_search_request("search", {
+    response = _brave_search_request("web/search", {
         "q": query,
         "count": min(limit, 20),
         "safesearch": "moderate",

@@ -916,7 +914,16 @@ def web_search_tool(query: str, limit: int = 10, task_id: str = None) -> str:
-        if backend == "exa":
-            response_data = _exa_search(query, limit)
-            # ...
